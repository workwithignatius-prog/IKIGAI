# Copy to .env (or set these in your host's dashboard)
PORT=3000
# Long random string. Unlocks /admin (submissions + CSV export). Leave empty to disable admin.
ADMIN_TOKEN=
# Where the SQLite database lives. Use a persistent disk on your host.
DB_FILE=./data/ikigai.db
# Turns on the Claude-powered cognitive engine. Leave empty to use the rule-based engine.
ANTHROPIC_API_KEY=
